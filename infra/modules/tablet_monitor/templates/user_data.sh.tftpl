#!/bin/bash
# Tablet monitor bootstrap (ADR-038). Runs once, on the instance's first
# boot (cloud-init per-instance). Later boots (the start/stop around each
# check-in) only start the systemd services this script installs: NetBird
# keeps its peer identity in /var/lib/netbird on the root volume.
set -euo pipefail
exec > >(tee -a /var/log/tablet-monitor-bootstrap.log) 2>&1
echo "bootstrap start $(date -u +%FT%TZ)"

REGION="${region}"
secret() {
  aws secretsmanager get-secret-value --region "$REGION" --secret-id "$1" \
    --query SecretString --output text
}

# No dnf: on a t3.nano (0.5 GiB) "dnf install" was killed for lack of
# memory on the first deploy (2026-11-20). Python, already on the image,
# does the unzip and the JSON parsing instead. A 1 GiB swap file gives the
# NetBird daemon, adb and the monitor some headroom.
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=1024 status=none
  chmod 600 /swapfile
  mkswap /swapfile >/dev/null
  echo "/swapfile none swap defaults 0 0" >> /etc/fstab
fi
swapon -a

# NetBird client, pinned and checksum-verified.
curl -fsSL -o /tmp/netbird.tgz \
  "https://github.com/netbirdio/netbird/releases/download/v${netbird_version}/netbird_${netbird_version}_linux_amd64.tar.gz"
echo "${netbird_sha256}  /tmp/netbird.tgz" | sha256sum -c -
tar -xzf /tmp/netbird.tgz -C /usr/local/bin netbird
rm -f /tmp/netbird.tgz

# adb (Android platform-tools), pinned and checksum-verified.
curl -fsSL -o /tmp/platform-tools.zip \
  "https://dl.google.com/android/repository/platform-tools_r${platform_tools_version}-linux.zip"
echo "${platform_tools_sha256}  /tmp/platform-tools.zip" | sha256sum -c -
rm -rf /opt/platform-tools
python3 -m zipfile -e /tmp/platform-tools.zip /opt
chmod 755 /opt/platform-tools/adb
ln -sf /opt/platform-tools/adb /usr/local/bin/adb
rm -f /tmp/platform-tools.zip

# ADB key pair the tablets already trust (ADR-038 section 4).
install -d -m 700 /root/.android
secret "${adb_key_secret_arn}" | python3 -c 'import json,sys; d=json.load(sys.stdin); open("/root/.android/adbkey","w").write(d["private"]); open("/root/.android/adbkey.pub","w").write(d["public"])'
chmod 600 /root/.android/adbkey /root/.android/adbkey.pub

# Monitor program: downloaded from S3 at every service start (ExecStartPre),
# so a code change is an S3 upload, not an instance replacement. The
# download is checked with py_compile before it replaces the running copy;
# if it fails, the last good copy keeps running.
install -d -m 755 /opt/tablet-monitor
cat > /usr/local/bin/tablet-monitor-fetch <<'FETCH'
#!/bin/bash
set -euo pipefail
tmp=$(mktemp --suffix=.py)
trap 'rm -f "$tmp"' EXIT
aws s3 cp --region "$AWS_REGION" --only-show-errors "$CODE_URI" "$tmp"
python3 -m py_compile "$tmp"
install -m 755 "$tmp" /opt/tablet-monitor/monitor.py
echo "monitor.py updated from $CODE_URI ($(sha256sum /opt/tablet-monitor/monitor.py | cut -c1-12))"
FETCH
chmod 755 /usr/local/bin/tablet-monitor-fetch
install -d -m 700 /etc/tablet-monitor
cat > /etc/tablet-monitor/env <<'ENV'
AWS_REGION=${region}
INVENTORY_SECRET=${inventory_secret_arn}
NTFY_SECRET=${ntfy_topic_secret_arn}
CODE_URI=${code_uri}
CHECKINS=${checkins}
HOME=/root
ENV
cat > /etc/systemd/system/tablet-monitor.service <<'UNIT'
[Unit]
Description=Tablet monitor (ADR-038)
After=network-online.target netbird.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/tablet-monitor/env
# Leading "-": a failed download keeps the last good copy running.
ExecStartPre=-/usr/local/bin/tablet-monitor-fetch
ExecStart=/usr/bin/python3 /opt/tablet-monitor/monitor.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
UNIT

# NetBird: install the daemon, then enroll with the one-use setup key. The
# server may be down (outside a check-in window), so keep trying for up to
# two hours; the monitor service starts anyway and waits for an address.
/usr/local/bin/netbird service install
/usr/local/bin/netbird service start
systemctl daemon-reload
systemctl enable --now tablet-monitor.service

for i in $(seq 1 240); do
  # NB_SETUP_KEY keeps the key off the command line (and out of ps).
  if NB_SETUP_KEY="$(secret "${setup_key_secret_arn}")" /usr/local/bin/netbird up \
      --management-url "${management_url}" \
      --hostname "${netbird_hostname}"; then
    echo "enrolled after try $i"
    break
  fi
  sleep 30
done
/usr/local/bin/netbird status | head -5 || true
echo "bootstrap done $(date -u +%FT%TZ)"
